---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';

const isEnglish = Astro.locals.starlightRoute.lang === 'en-US';
const system = isEnglish ? '/en-us/sistema/' : '/sistema/';
const setting = isEnglish ? '/en-us/cenario/' : '/cenario/';
const compendiums = isEnglish ? '/en-us/compendios/' : '/compendios/';
const about = isEnglish ? '/en-us/creditos-e-licencas/' : '/creditos-e-licencas/';
---

<div class="tv-site-header">
	<div class="tv-site-header__brand"><SiteTitle /></div>
	<nav class="tv-site-header__nav" aria-label={isEnglish ? 'Main navigation' : 'Navegação principal'}>
		<a href={system}>{isEnglish ? 'System' : 'Sistema'}</a>
		<a href={setting}>{isEnglish ? 'Setting' : 'Cenário'}</a>
		<a href={compendiums}>{isEnglish ? 'Compendiums' : 'Compêndios'}</a>
		<a href={about}>{isEnglish ? 'About' : 'Sobre o projeto'}</a>
	</nav>
	<div class="tv-site-header__tools">
		<Search />
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>
