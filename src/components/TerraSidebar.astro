---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar, lang } = Astro.locals.starlightRoute;
const isEnglish = lang === 'en-US';

function containsCurrent(entry) {
	return entry.type === 'link' ? entry.isCurrent : entry.entries.some(containsCurrent);
}

const currentSection = sidebar.find((entry) => entry.type === 'group' && containsCurrent(entry));
const sectionItems = currentSection ? [currentSection] : sidebar;
const collapseLabel = isEnglish ? 'Collapse section menu' : 'Recolher menu da seção';
---

<div class="tv-sidebar-control">
	<button class="tv-sidebar-collapse" type="button" aria-expanded="true" aria-controls="tv-sidebar-nav" aria-label={collapseLabel} title={collapseLabel}>
		<svg class="tv-sidebar-collapse__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
	</button>
</div>
<div id="tv-sidebar-nav" class="tv-sidebar-nav">
	<SidebarPersister>
		<SidebarSublist sublist={sectionItems} />
	</SidebarPersister>
</div>
<div class="md:sl-hidden tv-sidebar-mobile-footer">
	<MobileMenuFooter />
</div>

<script>
	const storageKey = 'tv-sidebar-collapsed';
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>('.tv-sidebar-collapse');
	const setState = (collapsed: boolean) => {
		root.toggleAttribute('data-tv-sidebar-collapsed', collapsed);
		button?.setAttribute('aria-expanded', String(!collapsed));
		const english = document.documentElement.lang === 'en-US';
		const text = collapsed
			? (english ? 'Expand section menu' : 'Expandir menu da seção')
			: (english ? 'Collapse section menu' : 'Recolher menu da seção');
		button?.setAttribute('aria-label', text);
		if (button) button.title = text;
	};

	if (button) {
		let collapsed = false;
		try { collapsed = localStorage.getItem(storageKey) === 'true'; } catch {}
		setState(collapsed);
		button.addEventListener('click', () => {
			collapsed = !root.hasAttribute('data-tv-sidebar-collapsed');
			setState(collapsed);
			try { localStorage.setItem(storageKey, String(collapsed)); } catch {}
		});
	}
</script>
